# Production Environment Configuration
ODIN_CHAT_LLM_URL=https://expand-unexpected-delhi-strong.trycloudflare.com
ODIN_CHAT_LLM_MODEL=qwen2.5:3b
ODIN_CHAT_LLM_TIMEOUT=120
ODIN_CHAT_LLM_BEARER_TOKEN=

# CORS Origins (Set this to your Vercel URL in Render dashboard)
ODIN_CHAT_CORS_ORIGINS=https://odin-chat-assistant.vercel.app

# Frontend API URL (Set this in Vercel environment variables to your Render URL)
NEXT_PUBLIC_ODIN_CHAT_API_URL=https://odin-chat-backend.onrender.com

# RAG Knowledge Retrieval Settings
ODIN_CHAT_RAG_ENABLED=true
ODIN_CHAT_RAG_PERSIST_DIR=/data/rag
ODIN_CHAT_RAG_EMBEDDING_MODEL=nomic-embed-text
ODIN_CHAT_RAG_CHUNK_SIZE=500
ODIN_CHAT_RAG_CHUNK_OVERLAP=50
ODIN_CHAT_RAG_TOP_K=5
